# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456:ABC-your-bot-token

# Natijalar yuboriladigan Telegram chat ID (sizning ID yoki guruh ID).
# Bir nechta bo'lsa vergul bilan: 111111,222222
ADMIN_CHAT_IDS=123456789

# Claude obuna (Pro/Max) akkaunt tokeni — `claude setup-token` buyrug'i bilan olinadi.
# API kalit EMAS. ANTHROPIC_API_KEY o'rnatmang.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Minimal ball (0-100). Shundan yuqori nomzodlar sizga yuboriladi
MIN_SCORE=70

# Ixtiyoriy: model (sonnet | opus | haiku), default: sonnet
CLAUDE_MODEL=sonnet

# Ixtiyoriy: bir vaqtda nechta rezyume tahlil qilinsin (default 1)
ANALYSIS_CONCURRENCY=1

# Ixtiyoriy: hammasini (rad etilganlarini ham) qisqacha yuborish: true/false
NOTIFY_REJECTED=false
