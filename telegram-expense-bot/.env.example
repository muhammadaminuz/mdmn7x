# Telegram bot token from @BotFather
BOT_TOKEN=

# Google Sheets spreadsheet ID (the long id in the sheet URL between /d/ and /edit)
SPREADSHEET_ID=

# Path to the Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Anthropic API key — enables AI parsing of free-text expense messages.
# If left empty, the bot falls back to a simple rule-based parser (first number = amount).
ANTHROPIC_API_KEY=
