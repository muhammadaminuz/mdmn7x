# Telegram bot token from @BotFather
BOT_TOKEN=

# Google Sheets spreadsheet ID (the long id in the sheet URL between /d/ and /edit)
SPREADSHEET_ID=

# Path to the Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# AI parsing of free-text expense messages. Priority: Gemini first, then Anthropic,
# then a simple rule-based fallback (first number = amount) if neither key is set.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
